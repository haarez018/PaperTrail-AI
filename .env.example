# Application
DEMO_MODE=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/papertrail.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL (for frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODE=hybrid
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE_INTAKE=0.4
LLM_TEMPERATURE_DOCUMENT=0.2
LLM_TEMPERATURE_ESCALATION=0.2
LLM_MAX_RETRIES=2
LLM_FALLBACK_TO_DETERMINISTIC=true
